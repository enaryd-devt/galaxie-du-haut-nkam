<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_source_location" model="ir.ui.view">
        <field name="name">stock.picking.form.source.location.line</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_ids_without_package']/list/field[@name='product_uom_qty']" position="after">
                <field name="allowed_source_location_ids" column_invisible="True"/>
                <field name="source_available_qty" string="Disponible" readonly="1" optional="show"/>
                <field name="source_location_id"
                    string="Emplacement source"
                    domain="[('id', 'in', allowed_source_location_ids)]"
                    options="{'no_create': True, 'no_open': True}"
                    readonly="state in ['done', 'cancel'] or parent.state in ['done', 'cancel']"
                    optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_form_source_location" model="ir.ui.view">
        <field name="name">stock.move.form.source.location.line</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='main_grp_col1']/field[@name='location_id']" position="after">
                <field name="allowed_source_location_ids" invisible="1"/>
                <field name="source_location_id"
                    domain="[('id', 'in', allowed_source_location_ids)]"
                    options="{'no_create': True, 'no_open': True}"
                    readonly="state in ['done', 'cancel']"/>
                <field name="source_available_qty" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
