<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_product_label_custom">
        <t t-call="web.basic_layout">
            <!-- Planche sans marge ni trait : le report met une classe "container"
                 (padding) sur body, et Bootstrap des bordures sur les tableaux. -->
            <style>
                html, body, body.container, main, .article { margin: 0 !important; padding: 0 !important; max-width: none !important; width: 100% !important; }
                .o_ptk_label_sheet, .o_ptk_label_sheet tbody, .o_ptk_label_sheet tr, .o_ptk_label_sheet td { border: none !important; border-width: 0 !important; outline: none !important; box-shadow: none !important; }
            </style>
            <t t-foreach="pages" t-as="page_rows">
                <div class="page" t-attf-style="box-sizing: border-box; height: {{ '%.2f' % page_height_mm }}mm; margin: 0; overflow: hidden; padding: 0;">
                    <table class="o_ptk_label_sheet" t-attf-style="border: none !important; border-collapse: separate !important; border-spacing: 0 !important; height: {{ '%.2f' % page_height_mm }}mm !important; margin: 0 !important; max-height: {{ '%.2f' % page_height_mm }}mm !important; page-break-inside: avoid !important; table-layout: fixed !important; width: 100% !important;">
                        <tbody>
                        <t t-foreach="page_rows" t-as="label_row">
                            <tr t-attf-style="height: {{ '%.2f' % label_height_mm }}mm !important; max-height: {{ '%.2f' % label_height_mm }}mm !important; page-break-inside: avoid !important;">
                                <t t-foreach="label_row" t-as="product">
                                    <td t-att-style="'box-sizing: border-box; height: %.2fmm !important; max-height: %.2fmm !important; border: 0 !important; padding: 0.5mm !important; page-break-inside: avoid !important; text-align: center; vertical-align: middle !important; overflow: hidden; word-break: break-word;' % (label_height_mm, label_height_mm)">
                                        <t t-if="product">
                                            <div style="color: #444; font-size: 5.5pt; font-weight: 600; line-height: 1; max-height: 3.5mm; overflow: hidden;">
                                                <span t-field="product.name"/>
                                            </div>
                                            <div t-if="product.default_code" style="font-size: 5.5pt; line-height: 1; margin-top: 0.2mm;">
                                                Réf. : <span t-field="product.default_code"/>
                                            </div>
                                            <div t-if="price_included" style="background: #f2f2f2; border: 0.2mm solid #222; border-radius: 0.5mm; color: #111; display: inline-block; font-size: 8pt; font-weight: 900; line-height: 1; margin-top: 0.2mm; padding: 0.2mm 0.8mm; white-space: nowrap;">
                                                <span t-out="prices[product.id]" t-options="{'widget': 'monetary', 'display_currency': currencies[product.id]}"/>
                                            </div>
                                            <div t-if="product.barcode" style="line-height: 0; margin-top: 0.2mm; text-align: center;">
                                                <img t-att-src="'/report/barcode/?barcode_type=Code128&amp;value=%s&amp;width=600&amp;height=180&amp;humanreadable=1' % product.barcode"
                                                     style="height: 7mm; max-width: 95%;" alt="Code-barres"/>
                                            </div>
                                            <div t-if="not product.barcode" style="font-size: 7pt; margin-top: 2mm;">Aucun code-barres</div>
                                            <div t-if="wizard.extra_html" style="font-size: 7pt; margin-top: 0.5mm;">
                                                <span t-field="wizard.extra_html"/>
                                            </div>
                                        </t>
                                    </td>
                                </t>
                            </tr>
                        </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
