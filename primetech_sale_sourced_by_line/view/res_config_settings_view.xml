<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.sale.sourced.by.line</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='sale_management']" position="inside">
                <block title="Sale Line Sourcing" name="sale_sourced_by_line_setting">
                <setting
                    id="sale_sourced_by_line_excluded_auto_warehouse_setting"
                    string="Excluded automatic warehouse"
                    help="This warehouse is never selected automatically on sale order lines, even when stock is available there. Salespeople can still select it manually."
                >
                    <field name="sale_sourced_by_line_excluded_auto_warehouse_id" />
                </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
