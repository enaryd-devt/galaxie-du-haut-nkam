<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_primetech_shop_form" model="ir.ui.view">
        <field name="name">primetech.shop.form</field>
        <field name="model">primetech.shop</field>
        <field name="arch" type="xml">
            <form string="Boutique">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_requests" type="object"
                                class="oe_stat_button" icon="fa-list">
                            <field name="request_count" widget="statinfo" string="Demandes"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Nom de la boutique"/></h1>
                    </div>
                    <group>
                        <group string="Identification">
                            <field name="code"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Responsables">
                            <field name="responsable_boutique_id"/>
                            <field name="responsable_magasin_id"/>
                            <field name="rayonniste_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <group>
                        <group string="Approvisionnement">
                            <field name="warehouse_id"/>
                            <field name="location_id"/>
                        </group>
                        <group string="Adresse">
                            <field name="address" nolabel="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_primetech_shop_tree" model="ir.ui.view">
        <field name="name">primetech.shop.tree</field>
        <field name="model">primetech.shop</field>
        <field name="arch" type="xml">
            <list string="Boutiques">
                <field name="code"/>
                <field name="name"/>
                <field name="responsable_boutique_id"/>
                <field name="responsable_magasin_id"/>
                <field name="warehouse_id"/>
            </list>
        </field>
    </record>

    <record id="action_primetech_shop" model="ir.actions.act_window">
        <field name="name">Boutiques</field>
        <field name="res_model">primetech.shop</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez votre première boutique
            </p>
        </field>
    </record>

</odoo>
